{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": [],
    "allowImportingTsExtensions": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/index.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "tests"
  ]
}
